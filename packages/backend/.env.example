# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crypto_gaming"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# CORS
CORS_ORIGIN=http://localhost:3000

# Crypto Networks
BTC_NETWORK=mainnet
BTC_REQUIRED_CONFIRMATIONS=3
ETH_NETWORK=mainnet
ETH_REQUIRED_CONFIRMATIONS=12
USDT_NETWORK=erc20
USDT_REQUIRED_CONFIRMATIONS=12

# Logging
LOG_LEVEL=info

# Game: Rock Paper Scissors
RPS_BASE_WIN_MULTIPLIER=1.95
RPS_STREAK_BONUS_STEP=0.1
RPS_MAX_STREAK_MULTIPLIER=1.5

# Game: Path Elimination (5 rows, JSON)
PATH_ELIMINATION_CONFIG=[{"winProbability":0.95,"multiplier":1.0105},{"winProbability":0.85,"multiplier":1.1294},{"winProbability":0.7,"multiplier":1.3714},{"winProbability":0.55,"multiplier":1.7455},{"winProbability":0.4,"multiplier":2.4}]

# Blockchain indexer & payouts
# Master seeds for deterministic per-user deposit addresses. Generate fresh
# values per environment and keep them out of version control.
#   mnemonic: node -e "const {ethers}=require('ethers');console.log(ethers.Mnemonic.fromEntropy(ethers.randomBytes(16)).phrase)"
#   seed:     node -e "const {ethers}=require('ethers');console.log(ethers.hexlify(ethers.randomBytes(32)))"
BLOCKCHAIN_INDEXER_ENABLED=true
BLOCKCHAIN_POLL_INTERVAL_MS=15000
BLOCKCHAIN_PAYOUT_INTERVAL_MS=10000
DEPOSIT_MNEMONIC=
DEPOSIT_SEED=

# Solana (Helius/QuickNode recommended in production)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_REQUIRED_CONFIRMATIONS=32
# Base58-encoded secret key of the payout hot wallet (must hold SOL for payouts)
SOLANA_HOT_WALLET_SECRET=
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# EVM (Alchemy/Infura recommended in production)
EVM_RPC_URL=https://ethereum-rpc.publicnode.com
EVM_CHAIN_ID=1
EVM_REQUIRED_CONFIRMATIONS=12
# Hex private key of the payout hot wallet (must hold ETH for gas + tokens)
EVM_HOT_WALLET_PRIVATE_KEY=
# ERC-20 contracts to watch (defaults are Ethereum mainnet; override per network)
EVM_USDT_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7
EVM_USDT_DECIMALS=6
EVM_USDC_CONTRACT=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
EVM_USDC_DECIMALS=6