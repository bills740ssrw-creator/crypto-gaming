{
  "name": "@crypto-gaming/backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@crypto-gaming/shared": "workspace:*",
    "@prisma/client": "catalog:",
    "@solana/web3.js": "^1.95.8",
    "@types/bs58": "^4.0.3",
    "bcryptjs": "catalog:",
    "bigint-conversion": "^1.0.0",
    "bignumber.js": "^9.1.2",
    "bs58": "^4.0.1",
    "cors": "catalog:",
    "dotenv": "catalog:",
    "ethers": "^6.13.4",
    "express": "catalog:",
    "helmet": "catalog:",
    "ioredis": "catalog:",
    "jsonwebtoken": "catalog:",
    "morgan": "catalog:",
    "redis": "catalog:",
    "socket.io": "catalog:",
    "winston": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "catalog:",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/morgan": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prisma": "catalog:",
    "tsx": "^4.7.0",
    "typescript": "catalog:"
  }
}